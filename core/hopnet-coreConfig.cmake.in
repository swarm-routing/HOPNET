#
# find_package(hopnet-core CONFIG REQUIRED): the imported static library hopnet::core,
# which links swarm::core from an installed swarm-core package (the version
# it was built against).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# the swarm-core this package was built against: the core holds swarm-core
# types by value, so another layout must be refused (swarm-core's version file
# accepts its own 0.y minor only before 1.0, its major from 1.0)
find_dependency(swarm-core @swarm-core_VERSION@ CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/hopnet-coreTargets.cmake")
check_required_components(hopnet-core)
